# COS-416: sign-ups locked down to the owner. Set to "true" to reopen registration.
# Unlike .env.local, this file IS shipped by deploy-front.sh - it's what next build reads on
# the server (Next.js always treats `next build` as NODE_ENV=production, .env.local is excluded
# from the rsync on purpose so dev-only overrides never reach prod).
NEXT_PUBLIC_SIGNUPS_ENABLED=false
